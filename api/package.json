{
  "name": "kundar-travel-api",
  "version": "0.1.0",
  "private": true,
  "description": "Kundar Travel stays-booking API (Express + MySQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.js",
    "db:seed:prod": "node --env-file=.env.production db/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  }
}
